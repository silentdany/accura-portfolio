# ─── Required ────────────────────────────────────────────────────────────────
# Neon: pooled URL for the app, direct URL for `prisma db push`
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/portfolio?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/portfolio?sslmode=require
BETTER_AUTH_SECRET=change-me-32-chars-minimum
NEXT_PUBLIC_SITE_URL=https://portfolio.accura.dev
# Only this email can create / use the admin account (recommended)
OWNER_EMAIL=dany@accura.dev

# ─── Sync (weekly Vercel Cron + "Synchroniser" in the admin) ────────────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GITHUB_OWNER=silentdany
GITHUB_TOKEN=
# Also list GitHub repos that have a homepage but no Vercel project (default true)
SYNC_GITHUB_HOMEPAGES=true
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# ─── Optional: AI enrichment (OpenAI-compatible gateway) ─────────────────────
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5

# ─── Accura Watch (real numbers on the cards) ────────────────────────────────
WATCH_URL=https://watch.accura.dev
WATCH_TOKEN=aw_...

# ─── API / MCP write access (Grok bots, Claude, scripts) ─────────────────────
PORTFOLIO_API_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────────────
# Phase 2 — shared session across *.accura.dev
# AUTH_COOKIE_DOMAIN=.accura.dev
# Local PDF export: path to a Chromium binary (Vercel uses @sparticuz/chromium)
# CHROMIUM_PATH=/usr/bin/chromium
